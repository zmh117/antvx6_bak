# -----------------------------------------------------------------------------
# PostgreSQL（back/app/config.py 读取，用于 ER 图持久化）
# 连接串：postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{DB}
# -----------------------------------------------------------------------------

# 数据库用户名
POSTGRES_USER=postgres
# 数据库密码
POSTGRES_PASSWORD=postgres
# 数据库名（需与 docker-compose 中 POSTGRES_DB 一致）
POSTGRES_DB=antvx6
# 主机：本机开发填 localhost；Docker 内后端服务填 postgres
POSTGRES_HOST=localhost
# 端口，默认 5432
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 前端（可选，写入 front/.env.local）
# -----------------------------------------------------------------------------

# 是否走后端 API 持久化（false 时仅用本地 er.json）
# VITE_USE_API=true
# API 根路径，开发留空由 Vite 代理 /api -> :8000
# VITE_API_BASE=
# 默认 ER 图 ID，与 migrations/001_schema.sql 种子数据一致
# VITE_GRAPH_ID=00000000-0000-0000-0000-000000000001